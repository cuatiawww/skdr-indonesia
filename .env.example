# Copy to .env and fill in. Never commit .env.
COMPOSE_PROJECT_NAME=skdr-indonesia

# PostgreSQL (docker container skdr-postgres)
POSTGRES_USER=skdr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skdr_indonesia
DB_HOST_PORT=5442

# Backend (Rust) - inside docker network the host is skdr-postgres:5432
DB_HOST=skdr-postgres
DB_PORT=5432
DB_USER=skdr
DB_PASSWORD=change-me
DB_NAME=skdr_indonesia
BACKEND_BIND_ADDR=0.0.0.0:8091
BACKEND_HOST_PORT=8091
MIGRATIONS_DIR=/init
RUST_LOG=info

# Frontend (Next.js)
FRONTEND_HOST_PORT=3200
BACKEND_INTERNAL_URL=http://skdr-backend-rust:8091

NEXT_PUBLIC_BASE_PATH=/skdr
# UI language: id (Bahasa Indonesia, default) or en
NEXT_PUBLIC_DEFAULT_LOCALE=id

# EBS sync (PR 005): User-Key for https://skdr.surveilans.org/api/ebs. Never commit the real key.
SKDR_EBS_USER_KEY=
