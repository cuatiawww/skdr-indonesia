# Copy to .env and fill in. Never commit .env.
COMPOSE_PROJECT_NAME=skdr-indonesia

# Existing PostgreSQL container on the shared Docker network.
# Do not add a PostgreSQL service to the new Compose stack.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=[REDACTED]
DB_NAME=skdr_indonesia

# Backend (Rust)
BACKEND_BIND_ADDR=0.0.0.0:8091
RUST_LOG=info
MIGRATIONS_DIR=/init

# Frontend (Next.js)
BACKEND_INTERNAL_URL=http://skdr-indonesia-backend:8091
NEXT_PUBLIC_BASE_PATH=/skdr
NEXT_PUBLIC_DEFAULT_LOCALE=id

# EBS sync (PR 005): User-Key for https://skdr.surveilans.org/api/ebs.
# Never commit the real key.
SKDR_EBS_USER_KEY=

# SATUSEHAT Master Sarana Index (PR 019): staging client credentials. Never commit the real secrets.
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=

# Login & user access (PR 029). The first admin (username `admin`) is seeded by migration
# database/init/052_seed_admin_must_change_password.sql and must change its default password at first login.
# Optional: credentials used only by scripts/smoke_test.sh (any active user with pe_input). Leave empty to be prompted.
SMOKE_USERNAME=
SMOKE_PASSWORD=
# Optional, defaults shown.
# Session cookie set by the backend. Behind HTTPS use SESSION_COOKIE_SECURE=true; SESSION_COOKIE_PATH may be the
# base path (e.g. /skdr) when other apps share the domain. The frontend reads SESSION_COOKIE_NAME too.
SESSION_COOKIE_NAME=skdr_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=false
