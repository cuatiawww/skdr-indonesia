      {
       "key": "status_laporan",
       "label": "Status Laporan",
       "type": "select",
       "row": 4,
       "options": [
        "Suspek Antraks",
        "Probabel Antraks",
        "Konfirmasi Antraks"
       ],
       "required": true,
       "col": "status_laporan",
       "warn": [
        {
         "when": {
          "all": [
           {
            "f": "status_laporan",
            "eq": "Konfirmasi Antraks"
           },
           {
            "not": {
             "all": [
              {
               "f": "lab_diperiksa",
               "eq": "Ya"
              },
              {
               "rows": "lab",
               "any": {
                "f": "hasil",
                "in": [
                 "Terdeteksi",
                 "Ditemukan Bakteri",
                 "Reaktif"
                ]
               }
              }
             ]
            }
           }
          ]
         },
         "msg": "Status Konfirmasi Antraks belum didukung hasil lab positif. Periksa kembali."
        }
       ]
      },
      {
       "key": "rumor_terkait",
       "label": "Apakah laporan berkaitan dengan rumor KLB/wabah atau kasus serupa lainnya?",
