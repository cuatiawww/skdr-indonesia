  "rules": [
   {
    "code": "konfirmasi",
    "label": "Konfirmasi Antraks",
    "when": {
     "all": [
      {
       "f": "lab_diperiksa",
       "eq": "Ya"
      },
      {
       "rows": "lab",
       "any": {
        "f": "hasil",
        "in": [
         "Terdeteksi",
         "Ditemukan Bakteri",
         "Reaktif"
        ]
       }
      }
     ]
    },
    "basis": "Hasil lab positif (PCR terdeteksi / kultur ditemukan bakteri / ELISA reaktif)."
   },
   {
    "code": "probabel",
    "label": "Probabel Antraks",
    "when": {
     "all": [
      {
       "any": [
        {
         "f": "kulit",
         "eq": "Ya"
        },
        {
         "f": "cerna",
         "eq": "Ya"
        },
        {
         "f": "napas",
         "eq": "Ya"
        }
       ]
      },
      {
       "any": [
        {
         "f": "kontak_hewan",
         "eq": "Ya"
        },
        {
         "f": "kontak_produk",
         "eq": "Ya"
        },
        {
         "rows": "kontak_orang_list",
         "any": {
          "f": "status",
          "in": [
           "Probabel Antraks",
           "Konfirmasi Antraks"
          ]
         }
        }
       ]
      }
     ]
    },
    "basis": "Gejala klinis antraks (kulit/saluran cerna/saluran napas) + kaitan epidemiologis (kontak hewan sakit/mati mendadak, produk hewan, atau kasus probabel/konfirmasi)."
   },
   {
    "code": "suspek",
    "label": "Suspek Antraks",
    "when": {
     "any": [
      {
       "f": "kulit",
       "eq": "Ya"
      },
      {
       "f": "cerna",
       "eq": "Ya"
      },
      {
       "f": "napas",
       "eq": "Ya"
      }
     ]
    },
    "basis": "Gejala klinis antraks (kulit/saluran cerna/saluran napas) tanpa kaitan epidemiologis."
   }
