{
 "form_key": "ai",
 "disease_code": "AVIAN_INFLUENZA",
 "version": 1,
 "no_pe_prefix": "PE-AI",
 "title": "Formulir Penyelidikan Epidemiologi (PE) Avian Influenza (Flu Burung) H5N1",
 "source": "Tracker review SKDR, sheet \"Form PE Avian Influenza - Spesi\" (docs/pe-spec/ai.json)",
 "age_reference": [
  "tgl_mulai_sakit",
  "tgl_laporan"
 ],
