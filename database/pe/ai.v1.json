    {
     "id": "A",
     "title": "A. Status Laporan",
     "fields": [
      {
       "key": "status_laporan",
       "label": "Status Laporan",
       "type": "select",
       "row": 4,
       "options": [
        "Suspek Flu Burung",
        "Probable Flu Burung",
        "Konfirmasi Flu Burung (H5N1)"
       ],
       "required": true,
       "col": "status_laporan",
       "warn": [
        {
         "when": {
          "all": [
           {
            "f": "status_laporan",
            "eq": "Konfirmasi Flu Burung (H5N1)"
           },
           {
            "not": {
             "all": [
              {
               "f": "spesimen",
               "eq": "Ya"
              },
              {
               "rows": "lab",
               "any": {
                "f": "hasil",
                "in": [
                 "Positif H5N1",
                 "Positif (serologi)"
                ]
               }
              }
             ]
            }
           }
          ]
         },
         "msg": "Status konfirmasi belum didukung hasil lab. Periksa kembali."
        }
       ]
      },
      {
       "key": "rumor_terkait",
       "label": "Apakah laporan berkaitan dengan rumor KLB/wabah atau kasus serupa lainnya?",
       "type": "select",
       "row": 5,
       "options": [
        "Ya",
        "Tidak",
        "Tidak tahu"
       ],
       "required": true
      },
      {
       "key": "tgl_rumor",
       "label": "Tanggal Rumor",
       "type": "date",
       "row": 6,
       "required": true,
       "visible": {
        "f": "rumor_terkait",
        "eq": "Ya"
       },
       "rules": [
        {
         "op": "<=",
         "ref": "tgl_laporan"
        },
        {
         "op": "<=",
         "ref": "tgl_pe"
        },
        {
         "op": "<=",
         "ref": "today"
        }
       ],
       "col": "tgl_rumor"
      },
      {
       "key": "lokasi_rumor",
       "label": "Lokasi Rumor",
       "type": "text",
       "row": 7,
       "required": true,
       "visible": {
        "f": "rumor_terkait",
        "eq": "Ya"
