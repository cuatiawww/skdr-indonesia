{
 "form_key": "rabies",
 "disease_code": "RABIES",
 "version": 1,
 "no_pe_prefix": "PE-RAB",
 "title": "Formulir Penyelidikan Epidemiologi (PE) Rabies/GHPR",
 "source": "Tracker review SKDR, sheet \"Form PE Rabies - Spesifikasi\" (docs/pe-spec/rabies.json)",
 "age_reference": [
  "tgl_mulai_sakit",
  "tgl_laporan"
 ],
 "steps": [
  {
   "id": "p1",
   "title": "Identitas Laporan, Pelaporan, dan Pasien",
