    {
     "id": "A",
     "title": "A. Status Laporan",
     "fields": [
      {
       "key": "status_laporan",
       "label": "Status Laporan",
       "type": "select",
       "row": 4,
       "options": [
        "Gigitan Hewan Penular Rabies",
        "Rabies Klinis",
        "Rabies Konfirmasi"
       ],
       "required": true,
       "col": "status_laporan",
       "warn": [
        {
         "when": {
          "all": [
           {
            "f": "status_laporan",
            "eq": "Gigitan Hewan Penular Rabies"
           },
           {
            "f": "digigit",
            "eq": "Tidak"
           }
          ]
         },
         "msg": "Status GHPR tetapi \"Apakah pernah digigit/dijilat/luka akibat HPR?\" = Tidak. Periksa kembali."
        },
        {
         "when": {
          "all": [
           {
            "f": "status_laporan",
            "eq": "Rabies Konfirmasi"
           },
           {
            "f": "lab_diperiksa",
            "filled": true
           },
           {
            "not": {
             "all": [
              {
               "f": "lab_diperiksa",
               "eq": "Ya"
              },
              {
               "f": "lab_hasil",
               "eq": "Positif"
              }
             ]
            }
           }
          ]
         },
         "msg": "Status Rabies Konfirmasi belum didukung hasil lab positif. Periksa kembali."
        }
       ]
      },
      {
       "key": "rumor_terkait",
       "label": "Apakah laporan berkaitan dengan rumor KLB/wabah atau kasus serupa lainnya?",
       "type": "select",
       "row": 5,
       "options": [
        "Ya",
        "Tidak",
        "Tidak tahu"
       ],
       "required": true
      },
      {
       "key": "tgl_rumor",
       "label": "Tanggal Rumor",
       "type": "date",
       "row": 6,
       "required": true,
       "visible": {
        "f": "rumor_terkait",
        "eq": "Ya"
       },
       "rules": [
        {
         "op": "<=",
         "ref": "tgl_laporan"
        },
        {
         "op": "<=",
         "ref": "tgl_pe"
        },
        {
         "op": "<=",
         "ref": "today"
        }
       ],
       "col": "tgl_rumor"
      },
      {
