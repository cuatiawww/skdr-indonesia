   "sections": [
    {
     "id": "E",
     "title": "E. Informasi Gigihat/luka Akibat HPR",
     "fields": [
      {
       "key": "digigit",
       "label": "Apakah pernah digigit/dijilat/luka akibat HPR?",
       "type": "select",
       "row": 40,
       "options": [
        "Ya",
        "Tidak"
       ],
       "required": true
      },
      {
       "key": "tgl_digigit",
       "label": "Tanggal digigit/dijilat/luka akibat HPR",
       "type": "date",
       "row": 41,
       "required": true,
       "visible": {
        "f": "digigit",
        "eq": "Ya"
       },
       "rules": [
        {
         "op": "<=",
         "ref": "tgl_pe"
        },
        {
         "op": "<=",
         "ref": "today"
        }
       ]
      },
      {
       "key": "lokasi_gigitan",
       "label": "Lokasi gigitan",
       "type": "select",
       "row": 42,
       "options": [
        "Kepala/wajah",
        "Telinga",
        "Leher",
        "Tangan",
        "Kaki",
        "Badan/berut/dada",
        "Bokong"
       ],
       "required": true,
       "visible": {
        "f": "digigit",
        "eq": "Ya"
       }
      },
      {
       "key": "tipe_luka",
       "label": "Tipe luka gigitan",
       "type": "select",
       "row": 43,
       "options": [
        "Jilatan",
        "Gigitan tembus kulit",
        "Gigitan tidak tembus kulit",
        "Cakaran tembus kulit",
        "Cakaran tidak tembus kulit"
       ],
       "required": true,
       "visible": {
        "f": "digigit",
        "eq": "Ya"
       }
      },
      {
       "key": "kategori_luka",
       "label": "Kategori luka",
       "type": "auto",
       "row": 44,
       "options": [
        "Kategori 1",
        "Kategori 2",
        "Kategori 3"
       ],
       "required": false,
       "visible": {
        "f": "digigit",
        "eq": "Ya"
       },
       "derive": {
        "fn": "first_match",
        "cases": [
         {
          "when": {
           "all": [
            {
             "f": "digigit",
             "eq": "Ya"
            },
            {
             "f": "jenis_hpr",
             "eq": "Kelelawar"
            }
           ]
          },
          "value": "Kategori 3"
         },
         {
          "when": {
           "all": [
            {
             "f": "digigit",
             "eq": "Ya"
            },
            {
             "f": "tipe_luka",
             "in": [
              "Gigitan tembus kulit",
              "Cakaran tembus kulit"
             ]
            }
           ]
          },
          "value": "Kategori 3"
         },
         {
          "when": {
           "all": [
            {
             "f": "digigit",
             "eq": "Ya"
            },
            {
             "f": "tipe_luka",
             "in": [
              "Gigitan tidak tembus kulit",
              "Cakaran tidak tembus kulit"
             ]
            }
           ]
          },
          "value": "Kategori 2"
         },
         {
          "when": {
           "all": [
            {
             "f": "digigit",
             "eq": "Ya"
            },
            {
             "f": "tipe_luka",
             "eq": "Jilatan"
            }
           ]
          },
          "value": "Kategori 1"
         }
        ]
       },
       "hint": "Diturunkan otomatis dari Tipe luka gigitan (kontak kelelawar = Kategori 3)."
      }
     ]
    }
   ]
  },
